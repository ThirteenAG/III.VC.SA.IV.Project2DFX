{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {"id": "VCLodLights", "name": "@plugin.name", "priority": 60, "games": [{"name": "Grand Theft Auto: Vice City", "exe": ["gta-vc.exe"]}]},
  "pages": [
    {"id": "drawdistance", "title": "@page.drawdistance", "section": "graphics"},
    {"id": "lights", "title": "@page.lights", "section": "graphics"},
    {"id": "effects", "title": "@page.effects", "section": "other"}
  ],
  "settings": [
    {"id": "DISTANCE.ViewDistance", "type": "int", "default": 1000, "min": 0, "max": 3000, "step": 100, "suggestions": [{"value": 0, "label": "@ViewDistance.game"}, {"value": 1000}, {"value": 2000}], "label": "@ViewDistance", "description": "@ViewDistance.description", "page": "drawdistance", "control": ["slider", "stepper"], "presets": {"vanilla": 0, "recommended": 1000, "enhanced": 2000}},
    {"id": "DISTANCE.DrawDistance", "type": "float", "default": 2.5, "min": 1, "max": 5, "step": 0.25, "decimals": 2, "suggestions": [{"value": 1}, {"value": 2.5}, {"value": 4}], "label": "@DrawDistance", "description": "@DrawDistance.description", "page": "drawdistance", "control": ["slider", "stepper"], "presets": {"vanilla": 1, "recommended": 2.5, "enhanced": 4}},
    {"id": "DISTANCE.DetailDistance", "type": "float", "default": 2, "min": 1, "max": 4, "step": 0.25, "decimals": 2, "label": "@DetailDistance", "description": "@DetailDistance.description", "page": "drawdistance", "control": ["slider", "stepper"], "presets": {"vanilla": 1, "recommended": 2, "enhanced": 3}},
    {"id": "DISTANCE.ShadowDistance", "type": "float", "default": 4, "min": 1, "max": 8, "step": 0.5, "decimals": 1, "label": "@ShadowDistance", "description": "@ShadowDistance.description", "page": "drawdistance", "control": ["slider", "stepper"], "apply": "restart", "presets": {"vanilla": 1, "recommended": 4, "enhanced": 7.5}},
    {"id": "LIGHTS.DistantLights", "type": "bool", "default": 1, "label": "@DistantLights", "description": "@DistantLights.description", "page": "lights", "control": ["switch", "cycler"], "presets": {"vanilla": 0, "recommended": 1, "enhanced": 1}},
    {"id": "LIGHTS.DistantLightShadows", "type": "bool", "default": 1, "label": "@DistantLightShadows", "description": "@DistantLightShadows.description", "page": "lights", "control": ["switch", "cycler"], "enabledIf": {"setting": "LIGHTS.DistantLights", "equals": 1}, "presets": {"vanilla": 0, "recommended": 1, "enhanced": 1}},
    {"id": "LIGHTS.DistantTraffic", "type": "choice", "default": 2, "choices": [{"value": 0, "label": "@DistantTraffic.off"}, {"value": 1, "label": "@DistantTraffic.lights"}, {"value": 2, "label": "@DistantTraffic.vehicles"}], "label": "@DistantTraffic", "description": "@DistantTraffic.description", "page": "lights", "control": ["cycler"], "presets": {"vanilla": 0, "recommended": 2, "enhanced": 2}},
    {"id": "LIGHTS.Searchlights", "type": "bool", "default": 1, "label": "@Searchlights", "description": "@Searchlights.description", "page": "lights", "control": ["switch", "cycler"], "presets": {"vanilla": 0, "recommended": 1, "enhanced": 1}},
    {"id": "LIGHTS.DistantLightSize", "type": "float", "default": 1, "min": 0.25, "max": 4, "step": 0.05, "decimals": 2, "label": "@DistantLightSize", "description": "@DistantLightSize.description", "page": "lights", "visibility": "file", "enabledIf": {"setting": "LIGHTS.DistantLights", "equals": 1}},
    {"id": "EFFECTS.RandomExplosionEffects", "type": "bool", "default": 1, "label": "@RandomExplosionEffects", "description": "@RandomExplosionEffects.description", "page": "effects", "control": ["switch", "cycler"], "apply": "restart", "presets": {"vanilla": 0, "recommended": 1, "enhanced": 1}},
    {"id": "EFFECTS.ReplaceSmokeTrailWithBulletTrail", "type": "bool", "default": 1, "label": "@ReplaceSmokeTrailWithBulletTrail", "description": "@ReplaceSmokeTrailWithBulletTrail.description", "page": "effects", "control": ["switch", "cycler"], "apply": "restart", "presets": {"vanilla": 0, "recommended": 1, "enhanced": 1}}
  ]
}
