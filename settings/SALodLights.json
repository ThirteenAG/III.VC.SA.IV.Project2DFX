{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {"id": "SALodLights", "name": "@plugin.name", "priority": 60, "games": [{"name": "Grand Theft Auto: San Andreas", "exe": ["gta_sa.exe", "gta-sa.exe"]}]},
  "pages": [
    {"id": "lights", "title": "@page.lights", "section": "graphics"},
    {"id": "traffic", "title": "@page.traffic", "section": "graphics"},
    {"id": "shadows", "title": "@page.shadows", "section": "graphics"},
    {"id": "searchlights", "title": "@page.searchlights", "section": "graphics"},
    {"id": "drawdistance", "title": "@page.drawdistance", "section": "graphics"}
  ],
  "settings": [
    {"id": "LODLIGHTS.RenderLodLights", "type": "bool", "default": 1, "label": "@RenderLodLights", "description": "@RenderLodLights.description", "page": "lights", "control": ["switch", "cycler"], "presets": {"vanilla": 0, "recommended": 1, "enhanced": 1}},
    {"id": "LODLIGHTS.CoronaRadiusMultiplier", "type": "float", "default": 0.5, "min": 0, "max": 4, "step": 0.05, "decimals": 2, "label": "@CoronaRadiusMultiplier", "description": "@CoronaRadiusMultiplier.description", "page": "lights", "control": ["slider"], "visibility": "editor", "enabledIf": {"setting": "LODLIGHTS.RenderLodLights", "equals": 1}},
    {"id": "LODLIGHTS.SlightlyIncreaseRadiusWithDistance", "type": "bool", "default": 1, "label": "@SlightlyIncreaseRadiusWithDistance", "description": "@SlightlyIncreaseRadiusWithDistance.description", "page": "lights", "control": ["switch", "checkbox"], "visibility": "editor", "enabledIf": {"setting": "LODLIGHTS.RenderLodLights", "equals": 1}},
    {"id": "LODLIGHTS.CoronaFarClip", "type": "float", "default": 0, "min": 0, "max": 10000, "step": 100, "unit": "m", "special": [{"value": 0, "label": "@special.auto"}], "label": "@CoronaFarClip", "description": "@CoronaFarClip.description", "page": "lights", "control": ["slider"], "visibility": "editor", "enabledIf": {"setting": "LODLIGHTS.RenderLodLights", "equals": 1}},
    {"id": "LODLIGHTS.CoronaAlphaNearMinMult", "type": "float", "default": 0.5, "min": 0, "max": 1, "step": 0.05, "decimals": 2, "label": "@CoronaAlphaNearMinMult", "description": "@CoronaAlphaNearMinMult.description", "page": "lights", "visibility": "file"},
    {"id": "LODLIGHTS.CoronaAlphaReachOneAt", "type": "float", "default": 150, "min": 0, "max": 5000, "step": 10, "unit": "m", "label": "@CoronaAlphaReachOneAt", "description": "@CoronaAlphaReachOneAt.description", "page": "lights", "visibility": "file"},
    {"id": "LODLIGHTS.CoronaAlphaBoostStartAt", "type": "float", "default": 150, "min": 0, "max": 5000, "step": 10, "unit": "m", "label": "@CoronaAlphaBoostStartAt", "description": "@CoronaAlphaBoostStartAt.description", "page": "lights", "visibility": "file"},
    {"id": "LODLIGHTS.CoronaAlphaFarBoostMax", "type": "float", "default": 4.0, "min": 1, "max": 10, "step": 0.1, "decimals": 1, "label": "@CoronaAlphaFarBoostMax", "description": "@CoronaAlphaFarBoostMax.description", "page": "lights", "visibility": "file"},
    {"id": "LODLIGHTS.MaxNumberOfLodLights", "type": "int", "default": 25000, "min": 1000, "max": 100000, "step": 1000, "label": "@MaxNumberOfLodLights", "description": "@MaxNumberOfLodLights.description", "page": "lights", "visibility": "file", "apply": "restart"},
    {"id": "LODLIGHTS.MaritimeTraffic", "type": "bool", "default": 1, "label": "@MaritimeTraffic", "description": "@MaritimeTraffic.description", "page": "traffic", "control": ["switch", "cycler"], "enabledIf": {"setting": "LODLIGHTS.RenderLodLights", "equals": 1}, "presets": {"vanilla": 0, "recommended": 1, "enhanced": 1}},
    {"id": "LODLIGHTS.MaxNumberOfDistantCars", "type": "int", "default": 1000, "min": 0, "max": 10000, "step": 100, "label": "@MaxNumberOfDistantCars", "description": "@MaxNumberOfDistantCars.description", "page": "traffic", "control": ["slider"], "visibility": "editor", "apply": "restart"},
    {"id": "LODLIGHTS.DistantCarsRadiusMultiplier", "type": "float", "default": 1.0, "min": 0, "max": 4, "step": 0.05, "decimals": 2, "label": "@DistantCarsRadiusMultiplier", "description": "@DistantCarsRadiusMultiplier.description", "page": "traffic", "control": ["slider"], "visibility": "editor"},
    {"id": "LODLIGHTS.DistantCars3D", "type": "bool", "default": 1, "label": "@DistantCars3D", "description": "@DistantCars3D.description", "page": "traffic", "control": ["switch", "checkbox"], "visibility": "editor"},
    {"id": "LODLIGHTS.DistantBoats3D", "type": "bool", "default": 1, "label": "@DistantBoats3D", "description": "@DistantBoats3D.description", "page": "traffic", "control": ["switch", "checkbox"], "visibility": "editor"},
    {"id": "LODLIGHTS.DistantCars3DLights", "type": "bool", "default": 1, "label": "@DistantCars3DLights", "description": "@DistantCars3DLights.description", "page": "traffic", "control": ["switch", "checkbox"], "visibility": "editor"},
    {"id": "LODLIGHTS.DistantCarsGroundOffset", "type": "float", "default": 0, "min": -2, "max": 2, "step": 0.1, "decimals": 1, "unit": "m", "label": "@DistantCarsGroundOffset", "description": "@DistantCarsGroundOffset.description", "page": "traffic", "visibility": "file"},
    {"id": "STATICSHADOWS.StaticShadowsIntensity", "type": "float", "default": 2.0, "min": 0, "max": 10, "step": 0.1, "decimals": 1, "special": [{"value": 0, "label": "@special.game"}], "label": "@StaticShadowsIntensity", "description": "@StaticShadowsIntensity.description", "page": "shadows", "control": ["slider"], "apply": "restart", "presets": {"vanilla": 0, "recommended": 2.0, "enhanced": 2.0}},
    {"id": "STATICSHADOWS.StaticShadowsDrawDistance", "type": "float", "default": 200, "min": 0, "max": 1000, "step": 10, "unit": "m", "special": [{"value": 0, "label": "@special.game"}], "label": "@StaticShadowsDrawDistance", "description": "@StaticShadowsDrawDistance.description", "page": "shadows", "control": ["slider"], "apply": "restart", "presets": {"vanilla": 0, "recommended": 200, "enhanced": 200}},
    {"id": "STATICSHADOWS.RenderStaticShadowsForLODs", "type": "bool", "default": 0, "label": "@RenderStaticShadowsForLODs", "description": "@RenderStaticShadowsForLODs.description", "page": "shadows", "control": ["switch", "checkbox"], "visibility": "editor"},
    {"id": "SEARCHLIGHTS.RenderSearchlightEffects", "type": "bool", "default": 1, "label": "@RenderSearchlightEffects", "description": "@RenderSearchlightEffects.description", "page": "searchlights", "control": ["switch", "cycler"], "presets": {"vanilla": 0, "recommended": 1, "enhanced": 1}},
    {"id": "SEARCHLIGHTS.RenderOnlyDuringFoggyWeather", "type": "bool", "default": 0, "label": "@RenderOnlyDuringFoggyWeather", "description": "@RenderOnlyDuringFoggyWeather.description", "page": "searchlights", "control": ["switch", "checkbox"], "visibility": "editor", "enabledIf": {"setting": "SEARCHLIGHTS.RenderSearchlightEffects", "equals": 1}},
    {"id": "SEARCHLIGHTS.SearchlightEffectVisibilityFactor", "type": "float", "default": 0.4, "min": 0, "max": 1, "step": 0.05, "decimals": 2, "label": "@SearchlightEffectVisibilityFactor", "description": "@SearchlightEffectVisibilityFactor.description", "page": "searchlights", "control": ["slider"], "visibility": "editor", "enabledIf": {"setting": "SEARCHLIGHTS.RenderSearchlightEffects", "equals": 1}},
    {"id": "FARCLIP.FarClipMultiplier", "type": "float", "default": 0, "min": 0, "max": 10000, "step": 0.5, "decimals": 1, "special": [{"value": 0, "label": "@special.dynamic"}], "suggestions": [{"value": 1}, {"value": 2}, {"value": 3}, {"value": 5}], "label": "@FarClipMultiplier", "description": "@FarClipMultiplier.description", "page": "drawdistance", "control": ["stepper", "slider"], "presets": {"vanilla": 1, "recommended": 0, "enhanced": 0}},
    {"id": "FARCLIP.HeightFactor", "type": "float", "default": 0.05, "min": 0, "max": 1, "step": 0.01, "decimals": 2, "label": "@HeightFactor", "description": "@HeightFactor.description", "page": "drawdistance", "control": ["slider"], "visibility": "editor", "enabledIf": {"setting": "FARCLIP.FarClipMultiplier", "equals": 0}},
    {"id": "FARCLIP.MinMultiplier", "type": "float", "default": 2.0, "min": 0.5, "max": 30, "step": 0.5, "decimals": 1, "label": "@MinMultiplier", "description": "@MinMultiplier.description", "page": "drawdistance", "control": ["slider"], "visibility": "editor", "enabledIf": {"setting": "FARCLIP.FarClipMultiplier", "equals": 0}},
    {"id": "FARCLIP.MaxMultiplier", "type": "float", "default": 4.0, "min": 0.5, "max": 30, "step": 0.5, "decimals": 1, "label": "@MaxMultiplier", "description": "@MaxMultiplier.description", "page": "drawdistance", "control": ["slider"], "visibility": "editor", "enabledIf": {"setting": "FARCLIP.FarClipMultiplier", "equals": 0}},
    {"id": "FARCLIP.TargetFPS", "type": "int", "default": 60, "min": 20, "max": 360, "step": 5, "unit": "fps", "label": "@TargetFPS", "description": "@TargetFPS.description", "page": "drawdistance", "control": ["slider"], "visibility": "editor", "enabledIf": {"setting": "FARCLIP.FarClipMultiplier", "equals": 0}},
    {"id": "FARCLIP.StaticSunSize", "type": "float", "default": 20.0, "min": 0, "max": 100, "step": 1, "special": [{"value": 0, "label": "@special.game"}], "label": "@StaticSunSize", "description": "@StaticSunSize.description", "page": "drawdistance", "control": ["slider"], "visibility": "editor", "apply": "restart"},
    {"id": "IDETWEAKER.LODObjectsDrawDistance", "type": "float", "default": 1300, "min": 0, "max": 5000, "step": 50, "special": [{"value": 0, "label": "@special.game"}], "label": "@LODObjectsDrawDistance", "description": "@LODObjectsDrawDistance.description", "page": "drawdistance", "control": ["slider"], "apply": "restart", "presets": {"vanilla": 0, "recommended": 1300, "enhanced": 1300}},
    {"id": "IDETWEAKER.GenericObjectsDrawDistance", "type": "float", "default": 300, "min": 0, "max": 3000, "step": 50, "special": [{"value": 0, "label": "@special.game"}], "label": "@GenericObjectsDrawDistance", "description": "@GenericObjectsDrawDistance.description", "page": "drawdistance", "control": ["slider"], "apply": "restart", "presets": {"vanilla": 0, "recommended": 300, "enhanced": 300}},
    {"id": "IDETWEAKER.AllNormalObjectsDrawDistance", "type": "float", "default": 0, "min": 0, "max": 3000, "step": 50, "special": [{"value": 0, "label": "@special.game"}], "label": "@AllNormalObjectsDrawDistance", "description": "@AllNormalObjectsDrawDistance.description", "page": "drawdistance", "control": ["slider"], "visibility": "editor", "apply": "restart"},
    {"id": "IDETWEAKER.VegetationDrawDistance", "type": "float", "default": 800, "min": 0, "max": 3000, "step": 50, "special": [{"value": 0, "label": "@special.game"}], "label": "@VegetationDrawDistance", "description": "@VegetationDrawDistance.description", "page": "drawdistance", "control": ["slider"], "apply": "restart", "presets": {"vanilla": 0, "recommended": 800, "enhanced": 800}},
    {"id": "IDETWEAKER.TimedObjectsDrawDistance", "type": "float", "default": 0, "min": 0, "max": 3000, "step": 50, "special": [{"value": 0, "label": "@special.game"}], "label": "@TimedObjectsDrawDistance", "description": "@TimedObjectsDrawDistance.description", "page": "drawdistance", "control": ["slider"], "visibility": "editor", "apply": "restart"},
    {"id": "IDETWEAKER.NeonsDrawDistance", "type": "float", "default": 0, "min": 0, "max": 3000, "step": 50, "special": [{"value": 0, "label": "@special.game"}], "label": "@NeonsDrawDistance", "description": "@NeonsDrawDistance.description", "page": "drawdistance", "visibility": "file", "apply": "restart"},
    {"id": "IDETWEAKER.MaxDrawDistanceForNormalObjects", "type": "float", "default": 300, "min": 0, "max": 3000, "step": 50, "unit": "m", "label": "@MaxDrawDistanceForNormalObjects", "description": "@MaxDrawDistanceForNormalObjects.description", "page": "drawdistance", "visibility": "file", "apply": "restart"},
    {"id": "IDETWEAKER.PreloadLODs", "type": "bool", "default": 1, "label": "@PreloadLODs", "description": "@PreloadLODs.description", "page": "drawdistance", "control": ["switch", "checkbox"], "apply": "restart", "presets": {"vanilla": 0, "recommended": 1, "enhanced": 1}}
  ]
}
